+
+/* ============ 设置面板 ============ */
+.settings-btn { font-size:20px; }
+.settings-panel {
+  position:fixed; right:76px; bottom:150px; z-index:51;
+  background:#1a2418; border:1px solid #ffd54a; border-radius:12px;
+  padding:14px 16px; box-shadow:0 4px 14px rgba(0,0,0,.6);
+  display:flex; flex-direction:column; gap:12px; min-width:200px;
+}
+.settings-row {
+  display:flex; align-items:center; justify-content:space-between;
+  color:#fff; font-size:14px; gap:12px;
+}
+.settings-panel .chat-close {
+  position:absolute; top:-10px; right:-10px;
+}
+/* 开关 toggle */
+.switch { position:relative; display:inline-block; width:46px; height:24px; }
+.switch input { opacity:0; width:0; height:0; }
+.switch .slider {
+  position:absolute; cursor:pointer; inset:0;
+  background:#3a4a36; border-radius:24px; transition:.2s;
+}
+.switch .slider:before {
+  content:""; position:absolute; height:18px; width:18px;
+  left:3px; top:3px; background:#fff; border-radius:50%; transition:.2s;
+}
+.switch input:checked + .slider { background:#ffd54a; }
+.switch input:checked + .slider:before { transform:translateX(22px); }
