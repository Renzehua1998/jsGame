+function avatarNameFor(idx){
+  // 地主用 avatar_landlord；两个农民按 idx 顺序用 peasant1/peasant2
+  if(view.landlord<0) return null; // 未确定身份
+  if(idx===view.landlord) return 'avatar_landlord';
+  // 农民：按除地主外的顺序
+  const peasants = [0,1,2].filter(x=>x!==view.landlord);
+  const which = peasants.indexOf(idx);
+  return which===0 ? 'avatar_peasant1' : 'avatar_peasant2';
