+/* ============ 送礼物 ============ */
+.gift-btn { font-size:20px; }
+.gift-panel {
+  position:fixed; right:192px; bottom:150px; z-index:51;
+  background:#1a2418; border:1px solid #ffd54a; border-radius:12px;
