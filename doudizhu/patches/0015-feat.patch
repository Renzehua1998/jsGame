+++ b/css/style.css
@@ -252,6 +252,24 @@ body.mobile .card-wrap, body.mobile .img-btn, body.mobile button { touch-action:
 .auto-btn { font-size:20px; }
 .auto-btn.active { background:#c0392b; color:#fff; animation:autoPulse 1.2s infinite; }
 @keyframes autoPulse { 0%,100%{box-shadow:0 3px 10px rgba(0,0,0,.5);} 50%{box-shadow:0 0 14px #c0392b;} }
