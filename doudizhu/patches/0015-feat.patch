 }
+/* ---- 送礼物 ---- */
+function initGiftPanel(){
+  const grid=document.getElementById('giftGrid');
+  if(!grid || grid.children.length>0) return;
+  ['coffee','roses','tomato','water'].forEach(g=>{
+    const btn=document.createElement('button');
+    btn.className='gift-item'; btn.title=GIFT_INFO[g].label;
+    btn.onclick=()=>chooseGift(g);
+    btn.appendChild(makeGiftEl(GIFT_INFO[g].fly, 0.16));
+    grid.appendChild(btn);
+  });
+}
+function toggleGiftPanel(force){
+  const p=document.getElementById('giftPanel');
+  if(!p) return;
+  if(force===false){ p.style.display='none'; giftPending=null; updateGiftHint(''); return; }
+  p.style.display = p.style.display==='flex'?'none':'flex';
+  giftPending=null; updateGiftHint('');
+}
+function updateGiftHint(txt){
+  const h=document.getElementById('giftHint'); if(h) h.textContent=txt;
+}
+function chooseGift(gift){
+  giftPending=gift;
+  toggleGiftPanel(false);
+  document.getElementById('giftPanel').style.display='none';
+  updateGiftHint('点击要送礼的玩家头像');
+  setActInfo('🎁 已选 '+GIFT_INFO[gift].label+'，点击目标玩家头像送出（点空白取消）');
+}
+function sendGiftTo(targetIdx){
+  if(!giftPending) return;
+  const gift=giftPending; giftPending=null;
+  updateGiftHint(''); setActInfo('');
+  flyGift(myIdx, targetIdx, gift);
+  if(role==='host') netBroadcast({t:'gift', from:0, to:targetIdx, gift});
+  else netSend(0, {t:'gift', from:myIdx, to:targetIdx, gift});
+  log('送出 '+GIFT_INFO[gift].label+' 给 玩家'+(targetIdx+1));
+}
+function flyGift(fromIdx, toIdx, gift){
+  const info=GIFT_INFO[gift]; if(!info) return;
+  const stage=document.querySelector('.stage');
+  const fromSeat=document.getElementById('seat'+cap(seatPos(fromIdx)));
+  const toSeat=document.getElementById('seat'+cap(seatPos(toIdx)));
+  if(!fromSeat||!toSeat||!stage) return;
+  const fx=fromSeat.offsetLeft+fromSeat.offsetWidth/2;
+  const fy=fromSeat.offsetTop+fromSeat.offsetHeight/2;
+  const tx=toSeat.offsetLeft+toSeat.offsetWidth/2;
+  const ty=toSeat.offsetTop+toSeat.offsetHeight/2;
+  const fly=makeGiftEl(info.fly, 0.2);
+  fly.style.cssText+='position:absolute;left:'+fx+'px;top:'+fy+'px;transform:translate(-50%,-50%);z-index:50;pointer-events:none;transition:left '+info.dur+'ms linear,top '+info.dur+'ms linear;';
+  if(info.spin) fly.style.cssText+='animation:giftFlyFast '+info.dur+'ms linear;';
+  stage.appendChild(fly);
+  requestAnimationFrame(()=>{ requestAnimationFrame(()=>{ fly.style.left=tx+'px'; fly.style.top=ty+'px'; }); });
+  setTimeout(()=>{
+    fly.remove();
+    const land=makeGiftEl(info.land, 0.3);
+    land.style.cssText+='position:absolute;left:'+tx+'px;top:'+ty+'px;z-index:49;pointer-events:none;animation:giftLand .4s ease-out;';
+    stage.appendChild(land);
+    setTimeout(()=>land.remove(), 2000);
+  }, info.dur);
+}
+function cancelGiftOnEmpty(e){
+  if(giftPending && !e.target.closest('.seat') && !e.target.closest('#giftPanel') && !e.target.closest('.gift-item')){
+    giftPending=null; updateGiftHint(''); setActInfo('');
+  }
+}
 function autoAct(){
   if(!autoPlay) return;
   // 叫地主阶段：不叫
@@ -457,6 +559,14 @@ function render(){
     renderAvatar(pos, i);
     renderCrown(pos, i);
     renderBadge(pos, i);
+    // 送礼物选目标
+    if(giftPending && i!==myIdx){
+      seat.style.cursor='pointer';
+      seat.style.boxShadow='0 0 0 2px #ffd54a';
+      seat.onclick=()=>sendGiftTo(i);
+    } else {
+      seat.style.cursor=''; seat.style.boxShadow=''; seat.onclick=null;
+    }
   }
   renderClock();
   renderOppHand('Left', view.hands[(myIdx+2)%3]);
