+.gift-item:hover { border-color:#ffd54a; transform:translateY(-2px); background:#2e3b2a; }
+.gift-sprite { background-repeat:no-repeat; }
+.gift-hint { color:#ffd54a; font-size:12px; text-align:center; margin-top:8px; min-height:16px; }
+@keyframes giftLand { 0%{transform:translate(-50%,-50%) scale(0.3);opacity:0;} 60%{transform:translate(-50%,-50%) scale(1.2);opacity:1;} 100%{transform:translate(-50%,-50%) scale(1);opacity:1;} }
+@keyframes giftFlyFast { 0%{transform:translate(-50%,-50%) rotate(0);} 100%{transform:translate(-50%,-50%) rotate(720deg);} }
 .settings-panel {
