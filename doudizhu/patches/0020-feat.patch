+/* 重连浮层 */
+.reconnect-overlay { position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:100; display:flex; align-items:center; justify-content:center; }
+.reconnect-box { background:#1a2418; border:2px solid #ffd54a; border-radius:16px; padding:24px 28px; max-width:460px; width:90%; position:relative; box-shadow:0 8px 32px rgba(0,0,0,.5); }
+.reconnect-box h3 { color:#ffd54a; margin:0 0 12px; text-align:center; }
+.reconnect-box p { color:#ccc; font-size:14px; line-height:1.6; }
+.reconnect-box textarea { width:100%; min-height:80px; margin:6px 0; box-sizing:border-box; }
