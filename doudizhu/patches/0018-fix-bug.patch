 .img-btn:hover { transform:translateY(-2px) scale(1.04); filter:brightness(1.12); }
 .img-btn:disabled { filter:grayscale(.7) brightness(.6); cursor:not-allowed; transform:none; }
+.txt-btn { background:linear-gradient(180deg,#f5e6a8,#d4a017); border:2px solid #8a6610; border-radius:8px; color:#3a2a08; font-weight:bold; font-size:18px; padding:10px 22px; cursor:pointer; margin:4px; transition:transform .12s, box-shadow .12s; box-shadow:0 2px 0 #8a6610; }
+.txt-btn:hover { transform:translateY(-2px); box-shadow:0 4px 8px rgba(0,0,0,.3); filter:brightness(1.08); }
+.txt-btn:active { transform:translateY(1px); box-shadow:0 1px 0 #8a6610; }
+.txt-btn:disabled { filter:grayscale(.6) brightness(.6); cursor:not-allowed; transform:none; }
 
