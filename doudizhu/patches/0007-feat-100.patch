-function endGame(winner){
-  H.phase='over'; view.phase='over';
-  const landlordWin = (winner===H.landlord);
-  const delta = H.bidMax * H.mult;
-  view.over = {winner, landlord:H.landlord, landlordWin, delta, mult:H.mult, bidMax:H.bidMax};
-  if(landlordWin){ view.scores[H.landlord]+=2*delta; for(let i=0;i<3;i++) if(i!==H.landlord) view.scores[i]-=delta; }
-  else { view.scores[H.landlord]-=2*delta; for(let i=0;i<3;i++) if(i!==H.landlord) view.scores[i]+=delta; }
-  log((landlordWin?'地主胜':'农民胜')+'，本局倍数 '+H.mult+'，底分 '+H.bidMax);
-  broadcastState();
-}
