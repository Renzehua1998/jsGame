-  if(!ol) return [hand.filter(c=>c.val===valsAsc[0])[0]];
-  const T=ol.type;
-  if(T==='single'){ for(const v of valsAsc) if(v>ol.main) return takeN(v,1); }
-  if(T==='pair'){ for(const v of valsAsc) if(v>ol.main && hasN(v,2)) return takeN(v,2); }
