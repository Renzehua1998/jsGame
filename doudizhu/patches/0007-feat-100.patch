diff --git a/css/style.css b/css/style.css
new file mode 100644
index 0000000..33f0018
--- /dev/null
+++ b/css/style.css
@@ -0,0 +1,251 @@
+* { margin:0; padding:0; box-sizing:border-box; }
+body {
+  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;
+  background: #0f1410;
+  color:#fff;
+  min-height:100vh;
+  display:flex; flex-direction:column; align-items:center;
+  padding:16px;
+}
+h1 { color:#ffd54a; margin-bottom:6px; }
+.subtitle { color:#888; margin-bottom:18px; font-size:13px; }
+.panel {
+  background:#1a2418; border:1px solid #2e3b2a; border-radius:12px;
+  padding:22px; margin:8px; width:100%; max-width:680px;
+}
+button {
+  background:#ffd54a; color:#2a1f00; border:none; padding:11px 22px;
+  border-radius:8px; font-size:15px; font-weight:bold; cursor:pointer;
+  margin:4px; transition:all .15s;
+}
+button:hover { background:#ffe07a; transform:translateY(-1px); }
+button.secondary { background:#3a4a36; color:#fff; }
+button.secondary:hover { background:#4a5d44; }
+button:disabled { background:#333; color:#666; cursor:not-allowed; transform:none; }
+button.danger { background:#c0392b; color:#fff; }
+textarea {
+  width:100%; height:90px; background:#0f1410; color:#9be08a;
+  border:1px solid #2e3b2a; border-radius:8px; padding:10px;
+  font-family:monospace; font-size:11px; resize:vertical; margin:6px 0;
+}
+.label { color:#aaa; font-size:13px; margin:8px 0 4px; }
+.step { display:none; animation:fadeIn .3s; }
+.step.active { display:block; }
+@keyframes fadeIn { from{opacity:0;transform:translateY(8px);} to{opacity:1;transform:translateY(0);} }
+.copy-hint {
+  background:#243018; padding:8px 10px; border-radius:6px;
+  font-size:12px; color:#bbb; margin:8px 0; border-left:3px solid #ffd54a;
+}
+.error-box {
+  background:#3a1a1a; border:1px solid #ff4444; color:#ff8888;
+  padding:10px; border-radius:8px; margin:8px 0; font-size:13px;
+}
+.loading { color:#ffd54a; font-size:13px; margin:8px 0; text-align:center; }
+.status { color:#9be08a; font-size:16px; margin:8px 0; text-align:center; }
+.slot { background:#0f1410; border:1px solid #2e3b2a; border-radius:8px; padding:10px; margin:8px 0; }
+.slot h4 { color:#ffd54a; margin-bottom:6px; }
+
+/* ============ 牌桌 ============ */
+#gameArea { width:100%; max-width:980px; }
+.stage {
+  position:relative; width:960px; height:560px; margin:0 auto;
+  background: radial-gradient(ellipse at center, #1a2a18 0%, #0c1409 80%);
+  border-radius:18px; overflow:hidden;
+}
+.table {
+  position:absolute; left:130px; top:110px; width:700px; height:340px;
+  background: radial-gradient(ellipse at 50% 40%, #3a8a55 0%, #2a6e40 55%, #1f5830 100%);
+  border-radius:170px;
+  border:14px solid #6b4423;
+  box-shadow:
+    inset 0 0 50px rgba(0,0,0,.45),
+    inset 0 0 0 3px #8a5a2e,
+    0 0 0 4px #3a2410,
+    0 12px 30px rgba(0,0,0,.55);
+}
+.table::before {
+  content:""; position:absolute; inset:6px; border-radius:160px;
+  border:2px dashed rgba(255,255,255,.06); pointer-events:none;
+}
+.seat { position:absolute; display:flex; flex-direction:column; align-items:center; gap:4px; }
+.seat .name { font-size:13px; color:#ffd54a; text-shadow:0 1px 2px #000; }
+.seat .avatar {
+  width:54px; height:54px; border-radius:50%;
+  background:#2a3a26; border:3px solid #ffd54a;
+  display:flex; align-items:center; justify-content:center;
+  font-size:22px; box-shadow:0 2px 6px rgba(0,0,0,.5);
+}
+.seat .count { font-size:12px; color:#cfe8c0; background:rgba(0,0,0,.4); padding:1px 8px; border-radius:10px; }
+.seat .crown { font-size:16px; margin-top:-2px; filter:drop-shadow(0 0 3px #ffd54a); }
+.seat.p-me   { left:50%; bottom:8px; transform:translateX(-50%); }
+.seat.p-right{ right:24px; top:90px; }
+.seat.p-left { left:24px; top:90px; }
+.opp-hand { display:flex; flex-direction:column; align-items:center; gap:1px; margin-top:2px; }
+.opp-hand .back { width:26px; height:36px; border-radius:3px; background:#1a3a6a; border:1px solid #0a1a3a; margin-top:-30px; box-shadow:0 0 0 1px #2a5a9a inset; }
+.opp-hand .back:first-child { margin-top:0; }
+
+.played-zone {
+  position:absolute; display:flex; gap:2px; align-items:center; justify-content:center;
+  flex-wrap:wrap; max-width:240px;
+}
+.played-zone.p-me   { left:50%; bottom:120px; transform:translateX(-50%); }
+.played-zone.p-right{ right:90px; top:170px; }
+.played-zone.p-left { left:90px; top:170px; }
+.played-label { font-size:11px; color:#cfe8c0; position:absolute; top:-16px; left:50%; transform:translateX(-50%); white-space:nowrap; }
+.played-pass { color:#ff9a9a; font-size:13px; padding:14px 18px; background:rgba(0,0,0,.35); border-radius:8px; }
+
+.bottom-area { position:absolute; left:0; right:0; bottom:88px; display:flex; justify-content:center; }
+.my-hand { display:flex; gap:0; padding:0 20px; min-height:118px; align-items:flex-end; }
+.my-hand .card-wrap { margin-left:-30px; cursor:pointer; transition:transform .12s; }
+.my-hand .card-wrap:first-child { margin-left:0; }
+.my-hand .card-wrap.selected { transform:translateY(-26px); }
+
+/* ============ 卡牌切片 ============ */
+.card {
+  background-image:url('../img/dou.png');
+  background-repeat:no-repeat;
+  border-radius:3px;
+  box-shadow:0 1px 3px rgba(0,0,0,.5);
+  --s:0.5;
+}
+.card.sm { --s:0.42; }
+.card.lg { --s:0.6; }
+
+/* 底牌区 */
+.bottom-cards { position:absolute; left:50%; top:56px; transform:translateX(-50%); display:flex; gap:4px; align-items:center; }
+.bottom-cards .label-b { font-size:11px; color:#ffd54a; margin-right:6px; align-self:center; }
+
+/* 出牌特效层 */
+.effect-layer {
+  position:absolute; left:50%; top:200px; transform:translateX(-50%);
+  display:flex; flex-direction:column; align-items:center; gap:6px;
+  pointer-events:none; z-index:30;
+}
+.effect-layer .effect-text {
+  font-size:30px; font-weight:bold; color:#fff;
+  text-shadow:0 0 8px #ff6600, 0 2px 4px #000, 0 0 20px #ffaa00;
+  animation:effectPop .4s ease-out;
+}
+.effect-layer.plane .effect-text { color:#66ccff; text-shadow:0 0 8px #0066ff,0 2px 4px #000,0 0 20px #66ccff; }
+@keyframes effectPop { 0%{transform:scale(0.3);opacity:0;} 60%{transform:scale(1.15);opacity:1;} 100%{transform:scale(1);opacity:1;} }
+
+/* 胜负横幅 */
+.banner-layer {
+  position:absolute; left:50%; top:230px; transform:translateX(-50%);
+  z-index:40; display:flex; flex-direction:column; align-items:center; gap:10px;
+  animation:effectPop .5s ease-out;
+}
+.banner-layer .banner-text { font-size:22px; font-weight:bold; color:#ffd54a; text-shadow:0 2px 4px #000; }
+
+/* 倍数卷轴（桌面中央） */
+.mult-scroll {
+  position:absolute; left:50%; top:108px; transform:translateX(-50%);
+  display:flex; align-items:center; gap:6px; z-index:5;
+}
+.mult-scroll .scroll-bg { position:relative; display:flex; align-items:center; justify-content:center; }
+.mult-scroll .mult-val { position:absolute; color:#5a2a10; font-weight:bold; font-size:14px; text-shadow:0 1px 0 #fff8e0; }
+.mult-scroll .label-m { color:#ffd54a; font-size:12px; }
+
+/* 局数/底分牌 */
+.sign-zone { position:absolute; display:flex; align-items:center; }
+.sign-zone.round { left:50%; top:28px; transform:translateX(-50%); flex-direction:column; gap:4px; }
+.sign-zone .sign-label { font-size:10px; color:#ffd54a; }
+
+/* 倒计时闹钟（当前出牌人） */
+.clock { position:absolute; width:52px; height:58px; z-index:15; animation:clockShake 1s infinite; }
+@keyframes clockShake { 0%,100%{transform:rotate(-4deg);} 50%{transform:rotate(4deg);} }
+
+/* 角色立绘 */
+.char-figure { position:absolute; opacity:.85; pointer-events:none; z-index:1; }
+.char-figure.p-me { left:50%; bottom:170px; transform:translateX(-50%); }
+.char-figure.p-right { right:8px; top:30px; }
+.char-figure.p-left { left:8px; top:30px; }
+
+/* 座位头像用素材 */
+.seat .avatar-sprite { width:54px; height:57px; border-radius:50%; border:3px solid #ffd54a; overflow:hidden; box-shadow:0 2px 6px rgba(0,0,0,.5); background-image:url('../img/dou.png'); background-repeat:no-repeat; }
+.seat .crown-sprite { position:absolute; top:-14px; left:50%; transform:translateX(-50%); }
+.seat .badge-sprite { margin-top:2px; }
+.seat { position:relative; }
+
+/* 角标图标栏 */
+.icon-bar { position:absolute; right:10px; bottom:8px; display:flex; gap:6px; opacity:.55; z-index:5; }
+.icon-bar .sprite { cursor:default; }
+
+/* 按钮图片 */
+.img-btn { background:transparent; border:none; padding:0; cursor:pointer; margin:3px; transition:transform .12s; display:inline-block; background-image:url('../img/dou.png'); background-repeat:no-repeat; }
+.img-btn:hover { transform:translateY(-2px) scale(1.04); filter:brightness(1.12); }
+.img-btn:disabled { filter:grayscale(.7) brightness(.6); cursor:not-allowed; transform:none; }
+
+/* 牌桌中央装饰扇形 */
+.table-fan { position:absolute; left:50%; top:130px; transform:translateX(-50%); opacity:.25; z-index:0; }
+
+/* 操作面板 */
+.actions {
+  width:100%; max-width:980px; margin:8px auto 0; text-align:center;
+  background:#1a2418; border:1px solid #2e3b2a; border-radius:12px; padding:12px;
+  min-height:56px;
+}
+.actions .info { color:#aaa; font-size:13px; margin-bottom:6px; }
+.bid-btns button { min-width:72px; }
+#logBox {
+  width:100%; max-width:980px; margin:8px auto 20px; background:#0f1410;
+  border:1px solid #2e3b2a; border-radius:8px; padding:8px 12px;
+  height:90px; overflow-y:auto; font-size:12px; color:#9be08a; font-family:monospace;
+}
+
+/* ============ 移动端 / 横屏适配 ============ */
+/* 竖屏旋转提示遮罩（移动端竖屏时显示） */
+.rotate-hint {
+  display:none; position:fixed; inset:0; z-index:9999;
+  background:#0f1410; color:#ffd54a;
+  flex-direction:column; align-items:center; justify-content:center;
+  text-align:center; padding:30px; gap:18px;
+}
+.rotate-hint .icon { font-size:64px; animation:rotHint 2s infinite ease-in-out; }
+.rotate-hint .msg  { font-size:18px; line-height:1.6; }
+.rotate-hint .sub  { font-size:13px; color:#888; }
+@keyframes rotHint { 0%,100%{transform:rotate(-90deg);} 50%{transform:rotate(0deg);} }
+
+/* 移动端检测标记：body.mobile 时启用缩放容器 */
+body.mobile { padding:4px; }
+body.mobile #gameArea { transform-origin:top center; }
+body.mobile h1 { font-size:18px; margin-bottom:2px; }
+body.mobile .subtitle { font-size:11px; margin-bottom:8px; }
+body.mobile .panel { padding:14px; margin:4px 0; }
+body.mobile button { padding:9px 16px; font-size:14px; }
+body.mobile textarea { font-size:12px; height:70px; }
+body.mobile #logBox { height:60px; font-size:11px; margin:4px auto 8px; }
+body.mobile .actions { padding:8px; }
+body.mobile .my-hand .card-wrap { margin-left:-26px; }
+body.mobile .seat .avatar-sprite { width:46px; height:48px; }
+body.mobile .seat .name { font-size:11px; }
+body.mobile .seat .count { font-size:11px; }
+
+/* 触摸优化：禁用高亮、tap延时 */
+* { -webkit-tap-highlight-color:transparent; -webkit-touch-callout:none; }
+body.mobile .card-wrap, body.mobile .img-btn, body.mobile button { touch-action:manipulation; }
+
+/* 竖屏（移动端）显示旋转提示 */
+@media (orientation:portrait) and (max-width:900px){
+  body.mobile .rotate-hint { display:flex; }
+}
+
+/* ============ 测试面板（开发用） ============ */
+#testPanel {
+  position:fixed; right:10px; top:10px; z-index:9000;
+  background:#1a2418; border:1px solid #ffd54a; border-radius:8px;
+  padding:10px; max-width:340px; max-height:80vh; overflow:auto;
+  font-size:12px; color:#9be08a; font-family:monospace;
+  box-shadow:0 4px 16px rgba(0,0,0,.6);
+}
+#testPanel.hidden { display:none; }
+#testPanel h3 { color:#ffd54a; font-size:13px; margin-bottom:6px; cursor:pointer; }
+#testPanel .test-result { margin:2px 0; padding:2px 4px; border-radius:3px; }
+#testPanel .test-ok { color:#6f6; background:rgba(60,180,60,.12); }
+#testPanel .test-fail { color:#f66; background:rgba(220,60,60,.15); }
+#testPanel .test-summary { color:#ffd54a; font-weight:bold; margin-top:6px; border-top:1px solid #2e3b2a; padding-top:4px; }
+#testToggle {
+  position:fixed; right:10px; top:10px; z-index:9001;
+  background:#ffd54a; color:#2a1f00; border:none; border-radius:6px;
+  padding:6px 10px; font-size:12px; font-weight:bold; cursor:pointer;
+}
