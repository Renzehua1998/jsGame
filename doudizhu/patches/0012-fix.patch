- 删除角标图标栏 iconBar (icon_volume/settings/chat/help/undo 无 onclick 按不动)
  与右下角聊天/设置功能按钮重复, 移除避免混淆
- 删除角色立绘 char-figure (大图遮挡座位导致头像布局乱)
- 删除 renderIconBar/renderCharFigure 函数及调用
- 座位定位修正: .seat 改 relative(单次声明), p-me/p-left/p-right 明确 position:absolute
- DOM 内皇冠移到头像之前, 内部顺序: 皇冠>头像>名字>徽章>手牌数
- me 出牌区与闹钟 bottom 调 300px 与座位错开
---
 css/style.css | 19 ++++---------------
 index.html    | 14 ++++----------
 js/game.js    | 33 +--------------------------------
 3 files changed, 9 insertions(+), 57 deletions(-)

diff --git a/css/style.css b/css/style.css
index 8edb921..2a09856 100644
--- a/css/style.css
+++ b/css/style.css
@@ -67,7 +67,7 @@ textarea {
   content:""; position:absolute; inset:6px; border-radius:160px;
   border:2px dashed rgba(255,255,255,.06); pointer-events:none;
 }
-.seat { position:absolute; display:flex; flex-direction:column; align-items:center; gap:4px; }
+.seat { position:relative; display:flex; flex-direction:column; align-items:center; gap:4px; }
 .seat .name { font-size:13px; color:#ffd54a; text-shadow:0 1px 2px #000; }
 .seat .avatar {
   width:54px; height:54px; border-radius:50%;
@@ -78,9 +78,9 @@ textarea {
 .seat .count { font-size:12px; color:#cfe8c0; background:rgba(0,0,0,.4); padding:1px 8px; border-radius:10px; }
 .seat .crown { font-size:16px; margin-top:-2px; filter:drop-shadow(0 0 3px #ffd54a); }
 /* 倒三角排布：我在正下方手牌上方，左右对手在上方两侧 */
-.seat.p-me   { left:50%; bottom:210px; transform:translateX(-50%); z-index:10; }
-.seat.p-right{ right:20px; top:60px; }
-.seat.p-left { left:20px; top:60px; }
+.seat.p-me   { position:absolute; left:50%; bottom:210px; transform:translateX(-50%); z-index:10; }
+.seat.p-right{ position:absolute; right:20px; top:60px; }
+.seat.p-left { position:absolute; left:20px; top:60px; }
 .opp-hand { display:flex; flex-direction:column; align-items:center; gap:1px; margin-top:2px; }
 .opp-hand .back { width:26px; height:36px; border-radius:3px; background:#1a3a6a; border:1px solid #0a1a3a; margin-top:-30px; box-shadow:0 0 0 1px #2a5a9a inset; }
 .opp-hand .back:first-child { margin-top:0; }
@@ -156,21 +156,10 @@ textarea {
 .clock { position:absolute; width:52px; height:58px; z-index:15; animation:clockShake 1s infinite; }
 @keyframes clockShake { 0%,100%{transform:rotate(-4deg);} 50%{transform:rotate(4deg);} }
 
-/* 角色立绘 */
-.char-figure { position:absolute; opacity:.85; pointer-events:none; z-index:1; }
-.char-figure.p-me { left:50%; bottom:170px; transform:translateX(-50%); }
-.char-figure.p-right { right:8px; top:30px; }
-.char-figure.p-left { left:8px; top:30px; }
-
 /* 座位头像用素材 */
 .seat .avatar-sprite { width:70px; height:74px; border-radius:8px; border:2px solid #ffd54a; overflow:hidden; box-shadow:0 2px 6px rgba(0,0,0,.5); background-image:url('../img/dou.png'); background-repeat:no-repeat; background-color:#2a3a26; }
 .seat .crown-sprite { position:absolute; top:-14px; left:50%; transform:translateX(-50%); }
 .seat .badge-sprite { margin-top:2px; }
-.seat { position:relative; }
-
-/* 角标图标栏 */
-.icon-bar { position:absolute; right:10px; bottom:8px; display:flex; gap:6px; opacity:.55; z-index:5; }
-.icon-bar .sprite { cursor:default; }
 
 /* 按钮图片 */
 .img-btn { background:transparent; border:none; padding:0; cursor:pointer; margin:3px; transition:transform .12s; display:inline-block; background-image:url('../img/dou.png'); background-repeat:no-repeat; }
