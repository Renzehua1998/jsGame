- canvas等比缩放, 最大边长200px
- JPEG逐步降质量(0.92->0.3)直到<100KB(base64长度<136K)
- 若仍超限继续缩小尺寸(80%递减)直到达标
- 移除100KB上传限制, 用户可上传任意大小图片
---
 js/game.js | 34 ++++++++++++++++++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/js/game.js b/js/game.js
index f4f3657..9080842 100644
--- a/js/game.js
+++ b/js/game.js
@@ -61,9 +61,39 @@ function saveAvatars(){ try{ localStorage.setItem('dou_avatars', JSON.stringify(
 function saveNicks(){ try{ localStorage.setItem('dou_nicks', JSON.stringify(customNicks)); }catch(e){} }
 function onAvatarPick(input){
   const file = input.files[0]; if(!file) return;
-  if(file.size > 102400){ alert('头像文件过大(>100KB)，请压缩后重试'); input.value=''; return; }
   const reader = new FileReader();
-  reader.onload = e=>{ myAvatar = e.target.result; const pv=document.getElementById('avatarPreview'); if(pv){ pv.src=myAvatar; pv.style.display='inline-block'; } };
+  reader.onload = e=>{
+    const img = new Image();
+    img.onload = ()=>{
+      // 限制最大边长200px，等比缩放
+      const maxSide = 200;
+      let w = img.width, h = img.height;
+      if(w > maxSide || h > maxSide){
+        const scale = maxSide / Math.max(w, h);
+        w = Math.round(w * scale); h = Math.round(h * scale);
+      }
+      const cv = document.createElement('canvas');
+      cv.width = w; cv.height = h;
+      cv.getContext('2d').drawImage(img, 0, 0, w, h);
+      // 逐步降低JPEG质量直到<100KB
+      let quality = 0.92, dataUrl = cv.toDataURL('image/jpeg', quality);
+      while(dataUrl.length > 136000 && quality > 0.3){
+        quality -= 0.1;
+        dataUrl = cv.toDataURL('image/jpeg', quality);
+      }
+      // 若JPEG仍超限，进一步缩小尺寸
+      while(dataUrl.length > 136000 && w > 32){
+        w = Math.round(w * 0.8); h = Math.round(h * 0.8);
+        cv.width = w; cv.height = h;
+        cv.getContext('2d').drawImage(img, 0, 0, w, h);
+        dataUrl = cv.toDataURL('image/jpeg', 0.7);
+      }
+      myAvatar = dataUrl;
+      const pv = document.getElementById('avatarPreview');
+      if(pv){ pv.src = myAvatar; pv.style.display = 'inline-block'; }
+    };
+    img.src = e.target.result;
+  };
   reader.readAsDataURL(file);
 }
 function getDisplayName(idx){
