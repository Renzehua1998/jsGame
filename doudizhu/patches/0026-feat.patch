+++ b/css/style.css
@@ -360,3 +360,12 @@ body.mobile .card-wrap, body.mobile .img-btn, body.mobile button { touch-action:
 .reconnect-box p { color:#ccc; font-size:14px; line-height:1.6; }
 .reconnect-box textarea { width:100%; min-height:80px; margin:6px 0; box-sizing:border-box; }
 .reconnect-box .chat-close { position:absolute; top:-12px; right:-12px; }
+
+/* 战绩统计 */
+.stats-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:8px; }
+.stat-item { background:rgba(0,0,0,.3); border-radius:8px; padding:10px 6px; text-align:center; }
+.stat-num { font-size:22px; font-weight:bold; color:var(--accent); }
+.stat-label { font-size:11px; color:#aaa; margin-top:2px; }
+.stats-history { max-height:200px; overflow-y:auto; }
+.hist-row { display:flex; justify-content:space-between; padding:4px 8px; border-bottom:1px solid rgba(255,255,255,.08); font-size:12px; color:#ccc; }
+.hist-row span:first-child { color:var(--accent); }
