+/* ============================================================
+   7. 渲染
+   ============================================================ */
+function seatPos(idx){
+  // 返回该座次在屏幕上的位置标签：me / right / left
+  // 围桌顺时针：0=底,1=右,2=左
+  const rel = (idx - myIdx + 3)%3;
+  return rel===0?'me': rel===1?'right':'left';
+}
+function render(){
+  // 三座位名称/地主皇冠/手牌数
+  for(let i=0;i<3;i++){
+    const pos = seatPos(i);
+    const seat = document.getElementById('seat'+cap(pos));
+    if(!seat) continue;
+    seat.querySelector('.name').textContent = (i===myIdx?'我':'玩家'+(i+1)) + (view.landlord===i?' 🏠':'');
+    const cntEl = seat.querySelector('.count');
+    cntEl.textContent = view.hands[i]!==undefined ? '🂠 '+view.hands[i] : '';
+    // 皇冠
+    let crown = seat.querySelector('.crown');
+    if(view.landlord===i){ if(!crown){ crown=document.createElement('div'); crown.className='crown'; crown.textContent='👑'; seat.insertBefore(crown, seat.querySelector('.count')); } }
+    else if(crown) crown.remove();
+  }
+  // 对手手牌（牌背堆）
+  renderOppHand('Left', view.hands[(myIdx+2)%3]);
+  renderOppHand('Right', view.hands[(myIdx+1)%3]);
+  // 底牌
+  renderBottom();
+  // 出牌区
+  renderPlayed('Left', (myIdx+2)%3);
+  renderPlayed('Right', (myIdx+1)%3);
+  renderPlayed('Me', myIdx);
+  // 我的手牌
+  renderMyHand();
+  // 操作面板自动态
+  renderActions();
+  // 状态条
+  const st=document.getElementById('gameStatus');
+  if(view.over){
+    const win = view.over.landlordWin ? '地主胜' : '农民胜';
+    st.textContent = '🎉 本局结束：'+win+' ｜ 倍数 '+view.mult+'（仅主机可见）｜ 积分 '+view.scores.join('/');
+  } else if(view.phase==='bid'){
+    st.textContent = '🟡 叫地主中 ｜ 当前最高 '+view.points+' 分';
+  } else if(view.phase==='play'){
+    st.textContent = '🟢 出牌中 ｜ 轮到 '+ (view.turn===myIdx?'你':('玩家'+(view.turn+1)));
+  } else {
+    st.textContent='🟢 已连接';
