+  };
+  mk(0,'不叫'); mk(1,'1分'); mk(2,'2分'); mk(3,'3分');
+}
+function doBid(v){
+  clearButtons();
+  if(role==='host') hostBid(0,v);
+  else netSend(0,{t:'bid',val:v});
+  setActInfo('已叫分，等待其他人...');
+}
+function showPlayUI(lastPlay){
+  const ol = role==='host'? H.lastPlay : lastPlay;
+  setActInfo(ol? '轮到你出牌（需管上）' : '轮到你出牌（自由出）');
+  const box=document.getElementById('actButtons'); box.innerHTML='';
+  const bPass=document.createElement('button'); bPass.className='secondary'; bPass.textContent='不出';
+  bPass.disabled = !ol; bPass.onclick=()=>doPass(); box.appendChild(bPass);
+  const bHint=document.createElement('button'); bHint.className='secondary'; bHint.textContent='提示';
+  bHint.onclick=()=>doHint(ol); box.appendChild(bHint);
+  const bPlay=document.createElement('button'); bPlay.textContent='出牌';
+  bPlay.onclick=()=>doPlay(); box.appendChild(bPlay);
+}
+function doPass(){
+  clearButtons();
+  if(role==='host') hostPass(0);
+  else netSend(0,{t:'pass'});
+  setActInfo('已不出，等待...');
+}
+function doPlay(){
+  const keys = Array.from(selected);
+  if(keys.length===0){ alert('请先选牌'); return; }
+  clearButtons();
+  if(role==='host') hostPlay(0, keys);
+  else netSend(0,{t:'play',cards:keys});
+  selected.clear();
+  setActInfo('已出牌，等待...');
+  render();
+}
+function doHint(ol){
+  const olType = (role==='host') ? H.lastPlay : ol;
+  const h = findHint(myHand, olType);
+  if(!h){ alert('没有可压制的牌型'); return; }
+  selected.clear();
+  h.forEach(c=>selected.add(cardKey(c)));
+  render();
+}
